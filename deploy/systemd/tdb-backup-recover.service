[Unit]
Description=Recover TDB only after an automation-owned maintenance stop
Wants=network-online.target
After=local-fs.target network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tdb-admin
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
ExecStart=/usr/bin/python3 -I -S -B /home/ubuntu/tdb-admin/daily_backup.py --config /home/ubuntu/tdb-admin/daily-backup.json recover
Restart=no
TimeoutStartSec=30min
TimeoutStopSec=30s
KillMode=control-group
Nice=10
CPUQuota=50%
MemoryHigh=256M
MemoryMax=384M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
