# Telegram
TELEGRAM_BOT_TOKEN_TWITCH=replace-with-telegram-bot-token

# Twitch credentials
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_ACCESS_TOKEN=replace-with-twitch-access-token

# Optional GraphQL Client ID; defaults to TwitchDownloader's comments Client ID if unset
# TWITCH_GQL_CLIENT_ID=replace-with-twitch-gql-client-id

# Application
TCD_HISTORY_ENABLED=false
TCD_SPOOL_DIR=_work
TCD_SPOOL_BATCH_MESSAGES=5000
TCD_SPOOL_BATCH_BYTES=4194304
TCD_DB_PATH=vod_history.db
TCD_LOG_LEVEL=INFO

# Private Linux pagination evidence; no extra requests, off by default.
TCD_PAGINATION_DIAGNOSTICS=false
# TCD_PAGINATION_DIAG_VOD=123456789
# TCD_PAGINATION_DIAG_START=20330
# TCD_PAGINATION_DIAG_END=20440
# Optional direct child of /tmp, named tdb-pagination-<numeric UID>[-suffix].
# TCD_PAGINATION_DIAG_DIR=/tmp/tdb-pagination-1000

# Experimental one-page repair. Independent of diagnostics; never enable broadly.
TCD_PAGINATION_REPAIR_PILOT=false
# All four settings are required when enabled for this VOD (example only).
# TCD_PAGINATION_REPAIR_VOD=2913809248
# TCD_PAGINATION_REPAIR_START=20343
# TCD_PAGINATION_REPAIR_END=20470
# TCD_PAGINATION_REPAIR_CONTROL_OFFSET=20330

# HTML disk pressure cleanup (bytes; binary GiB), checked every 10 minutes
TCD_HTML_CLEANUP_LOW_BYTES=5368709120
TCD_HTML_CLEANUP_TARGET_BYTES=8589934592
TCD_HTML_CLEANUP_INTERVAL_SECONDS=600

# HTML publication: local mode writes to <project>/_out
TCD_HTML_PUBLISH_MODE=local

# Optional future public mode configuration
# TCD_HTML_PUBLISH_MODE=public
# TCD_PUBLIC_HTML_DIR=replace-with-writable-public-directory
# TCD_PUBLIC_BASE_URL=https://replace-with-public-host
# TCD_PUBLIC_HTML_URL_PREFIX=/public_html
