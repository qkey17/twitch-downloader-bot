# Telegram
TELEGRAM_BOT_TOKEN_TWITCH=replace-with-telegram-bot-token

# Twitch credentials
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_ACCESS_TOKEN=replace-with-twitch-access-token

# Optional GraphQL Client ID; defaults to TwitchDownloader's comments Client ID if unset
# TWITCH_GQL_CLIENT_ID=replace-with-twitch-gql-client-id

# Application
TCD_HISTORY_ENABLED=false
TCD_SPOOL_DIR=_work
TCD_SPOOL_BATCH_MESSAGES=5000
TCD_SPOOL_BATCH_BYTES=4194304
TCD_DB_PATH=vod_history.db
TCD_LOG_LEVEL=INFO

# HTML publication: local mode writes to <project>/_out
TCD_HTML_PUBLISH_MODE=local

# Optional future public mode configuration
# TCD_HTML_PUBLISH_MODE=public
# TCD_PUBLIC_HTML_DIR=replace-with-writable-public-directory
# TCD_PUBLIC_BASE_URL=https://replace-with-public-host
# TCD_PUBLIC_HTML_URL_PREFIX=/public_html
